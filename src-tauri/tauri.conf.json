{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digitify",
  "version": "0.1.0",
  "identifier": "com.digitify.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Digitify",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://digitify.localhost; media-src 'self' blob: http://digitify.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://digitify.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Digitify",
    "shortDescription": "Your personal digital media library",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mpv"],
    "resources": {
      "binaries/vulkan-1.dll": "vulkan-1.dll",
      "binaries/pdfium.dll": "pdfium.dll",
      "binaries/licenses/pdfium/*": "licenses/pdfium/",
      "../tools/ffmpeg/*": "ffmpeg/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
