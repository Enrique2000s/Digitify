{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digitify",
  "version": "0.11.0",
  "identifier": "com.digitify.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Digitify",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://digitify.localhost digitify: https:; media-src 'self' blob: http://digitify.localhost digitify: https:; style-src 'self' 'unsafe-inline' blob:; font-src 'self' data: blob:; frame-src blob: http://localhost:* https://www.youtube-nocookie.com https://www.youtube.com https://open.spotify.com https://w.soundcloud.com; form-action 'none'; connect-src 'self' ipc: http://ipc.localhost http://digitify.localhost digitify:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Digitify",
    "copyright": "Copyright (c) 2026 Digitify contributors. MIT License.",
    "shortDescription": "Your media library and universal game launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mpv"],
    "resources": {
      "binaries/vulkan-1.dll": "vulkan-1.dll",
      "binaries/pdfium.dll": "pdfium.dll",
      "binaries/licenses/pdfium/*": "licenses/pdfium/",
      "../tools/ffmpeg/*": "ffmpeg/",
      "../tools/yt-dlp/yt-dlp.exe": "yt-dlp/yt-dlp.exe",
      "../tools/yt-dlp/deno.exe": "yt-dlp/deno.exe",
      "../tools/yt-dlp/yt-dlp.version": "yt-dlp/yt-dlp.version",
      "../tools/yt-dlp/licenses/*": "yt-dlp/licenses/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/manual/Digitify-Manual.pdf": "manual/Digitify-Manual.pdf",
      "resources/manual/Digitify-Manual-cover.png": "manual/Digitify-Manual-cover.png"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
