{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "appimage"],
    "externalBin": [],
    "resources": {
      "binaries/vulkan-1.dll": null,
      "binaries/pdfium.dll": null,
      "../tools/ffmpeg/*": null,
      "../tools/yt-dlp/yt-dlp.exe": null,
      "../tools/yt-dlp/deno.exe": null,
      "../tools/yt-dlp/yt-dlp": "yt-dlp/yt-dlp",
      "../tools/yt-dlp/deno": "yt-dlp/deno",
      "binaries/libpdfium.so": "libpdfium.so",
      "binaries/licenses/pdfium/*": "licenses/pdfium/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "linux": {
      "deb": {
        "depends": ["mpv", "ffmpeg", "udisks2", "gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"],
        "section": "video"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
